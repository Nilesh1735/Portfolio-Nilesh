# Every variable here is optional. The site renders fully without any of
# them; the feature each one powers simply switches off.

# "Ask my portfolio" assistant. Without it the chat replies that it is
# unavailable rather than erroring.  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# The /api/send contact endpoint.  https://resend.com
# Note: the /contact page is a list of links and does not post to this, so
# it is unused unless you wire a form back up.
RESEND_API_KEY=

# Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Umami analytics. Both are needed together or neither is used.
UMAMI_DOMAIN=
UMAMI_SITE_ID=
